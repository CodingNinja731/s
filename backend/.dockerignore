# Ignore dependencies, they will be installed in the container
node_modules

# Ignore logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Ignore local environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Ignore Dockerfile
Dockerfile

# Ignore git files
.git
.gitignore

# Ignore test files if not needed in production
tests/
jest.config.js
